{
  "name": "konutprojeleri-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/pg.mjs start",
    "db:stop": "node scripts/pg.mjs stop",
    "db:status": "node scripts/pg.mjs status",
    "db:reset": "node scripts/pg.mjs reset",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed-uretim": "node --conditions=react-server --import tsx prisma/seed-uretim.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "ozellik-senk": "node --conditions=react-server --import tsx scripts/ozellik-senk.ts",
    "test": "node scripts/testler.mjs",
    "db:demo": "node --conditions=react-server --import tsx scripts/demo-veri.ts",
    "isler": "node --conditions=react-server --import tsx scripts/zamanlanmis.ts",
    "icerik-tohum": "node --conditions=react-server --import tsx scripts/icerik-tohum.ts",
    "vercel-build": "prisma migrate deploy && npm run db:seed-uretim && npm run icerik-tohum && next build",
    "dns:kontrol": "node --import tsx scripts/dns-kontrol.ts",
    "db:seed-en": "node --conditions=react-server --import tsx scripts/seed-en.ts && node --conditions=react-server --import tsx scripts/seed-landing-en.ts",
    "yedek": "node scripts/yedek.mjs",
    "yedek:json": "node --conditions=react-server --import tsx scripts/yedek-json.ts",
    "erisim": "node --conditions=react-server --import tsx scripts/erisim.ts",
    "seo": "node --conditions=react-server --import tsx scripts/seo-denetim.ts",
    "test:seri": "node scripts/testler.mjs --seri",
    "test:hizli": "node scripts/testler.mjs talep panel guvenlik arama silme",
    "derle": "node scripts/derle.mjs",
    "ekran": "node scripts/ekran.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "maplibre-gl": "^6.3.0",
    "next": "^15.5.23",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^17.10.0-beta.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true
  }
}
