# ── Veritabanı ────────────────────────────────────────────────
# Yerelde gömülü PostgreSQL (npm run db:start). Üretimde yönetilen bir PostgreSQL.
DATABASE_URL="postgresql://postgres@localhost:5433/konutprojeleri?schema=public"

# ── Site ──────────────────────────────────────────────────────
# Kanonik URL, site haritası, hreflang ve e-posta bağlantıları bundan
# türetilir. ÜRETİMDE MUTLAKA gerçek alan adı olmalı: localhost kalırsa
# arama motorlarına ve gönderilen e-postalara localhost adresi gider.
#
# Üretim: https://www.konutprojeleri.com
NEXT_PUBLIC_SITE_URL="http://localhost:4311"

# ── Yönetici hesabı ───────────────────────────────────────────
# `npm run db:seed-uretim` bu ikisi tanımlıysa yönetici hesabını
# açar, değilse ATLAR ve panele hiç giriş yapılamaz. Vercel'de
# `vercel-build` betiği bu tohumlamayı çalıştırıyor, dolayısıyla
# ikisi de dağıtım ortamında tanımlı olmalı.
YONETICI_EPOSTA=""
YONETICI_PAROLA=""

# ── E-posta ───────────────────────────────────────────────────
# sahte  → göndermez, .postakutusu/ klasörüne HTML yazar (varsayılan)
# resend → HTTP API, ek bağımlılık yok
# smtp   → nodemailer üzerinden
EPOSTA_SAGLAYICI="sahte"
EPOSTA_GONDEREN="bildirim@konutprojeleri.com"
EPOSTA_GONDEREN_AD="KonutProjeleri"

# Resend kullanıyorsanız — https://resend.com/api-keys
RESEND_API_KEY=""

# SMTP kullanıyorsanız (465 → SSL, 587 → STARTTLS)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_KULLANICI=""
SMTP_PAROLA=""

# ── Zamanlanmış işler ─────────────────────────────────────────
# /api/isler uç noktasının anahtarı. TANIMLI DEĞİLSE UÇ NOKTA KAPALIDIR.
# Vercel Cron bu değeri Authorization: Bearer başlığıyla otomatik gönderir.
# Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=""

# ── SMS ───────────────────────────────────────────────────────
# sahte        → göndermez, .postakutusu/sms.log dosyasına yazar
# netgsm       → Türkiye'de en yaygın
# iletimerkezi → ikinci yaygın seçenek
SMS_SAGLAYICI="sahte"
# Sağlayıcıda ÖNCEDEN ONAYLANMIŞ gönderici başlığı olmalı
SMS_BASLIK="KONUTPROJELERI"

NETGSM_KULLANICI=""
NETGSM_PAROLA=""

ILETIMERKEZI_ANAHTAR=""
ILETIMERKEZI_GIZLI=""

# ── E-posta webhook (bounce / şikâyet) ────────────────────────
# Sağlayıcı panelinden alınan imzalama anahtarı (whsec_… ile başlar).
# TANIMLI DEĞİLSE /api/bildirim/webhook KAPALIDIR.
# Resend: Webhooks > Add Endpoint > https://www.konutprojeleri.com/api/bildirim/webhook
#         Olaylar: email.bounced, email.complained, email.delivered
EPOSTA_WEBHOOK_GIZLI=""

# ── Veritabanı (havuzlayıcı kullanılıyorsa) ───────────────────
# Migration'lar PgBouncer transaction modunda ÇALIŞMAZ (advisory lock yok).
# Supabase/Neon kullanıyorsanız:
#   DATABASE_URL → havuzlanmış adres (Supabase: port 6543, Neon: -pooler)
#   DIRECT_URL   → doğrudan adres (port 5432) — yalnızca migration için
# Migration adresi. Havuzlayıcı (6543) transaction modunda advisory
# lock desteklemediği için şema işlemleri buradan gidiyor.
#
# DİKKAT: Supabase'in `db.<ref>.supabase.co` konağı YALNIZCA IPv6 ve
# Vercel gibi IPv4 ortamlardan "P1001: Can't reach database server"
# veriyor. Havuzlayıcı konağının 5432 portunu kullanın — aynı sunucu,
# session modu, advisory lock destekliyor:
#   postgresql://postgres.<ref>:<parola>@aws-0-<bolge>.pooler.supabase.com:5432/postgres
DIRECT_URL=""

# ── Harita ────────────────────────────────────────────────────
# Boş bırakılırsa OpenStreetMap raster karoları kullanılır — bu
# YALNIZCA GELİŞTİRME İÇİNDİR, OSM politikası ticari kullanımı yasaklıyor.
# Üretimde bir sağlayıcı stil URL'i girin (MapTiler, Protomaps, Stadia).
NEXT_PUBLIC_HARITA_STIL=""

# ── Arama motoru doğrulama ────────────────────────────────────
GOOGLE_DOGRULAMA=""
BING_DOGRULAMA=""
YANDEX_DOGRULAMA=""

# IndexNow — Bing/Yandex'e anında bildirim. 8–128 karakter arası
# rastgele bir dize; /indexnow-key.txt adresinde yayınlanır.
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INDEXNOW_ANAHTAR=""

# ── Görsel CDN ────────────────────────────────────────────────
# Boşsa görseller kaynak adresinden servis edilir (şu an Unsplash).
# Üretimde kendi CDN'inizi tanımlayın.
NEXT_PUBLIC_GORSEL_CDN=""
# yok | cloudflare | bunny | imgix
NEXT_PUBLIC_GORSEL_SAGLAYICI="yok"

# Ev sahibi başvurusu geldiğinde uyarılacak adres(ler), virgülle ayrılmış.
# Tanımsızsa aktif yönetici hesaplarına gidiyor.
EKIP_EPOSTA=

# ── Fotoğraf deposu ───────────────────────────────────────────
# yerel    → web/.yukleme/ altına yazar, /api/gorsel'den servis eder.
#            YALNIZCA GELİŞTİRME: Vercel'de dosya sistemi salt okunur.
# supabase → Supabase Storage. Veritabanı zaten orada, yeni hesap
#            gerekmiyor. Kovayı HERKESE AÇIK OKUMA ile oluşturun.
# Boş bırakılırsa yükleme kapalı kalır, adres girerek eklemek çalışır.
DEPO_SURUCU="yerel"

# Supabase projesinin adresi (https://<ref>.supabase.co)
SUPABASE_URL=""
# DİKKAT: servis rolü anahtarı satır seviyesi güvenliğini tümüyle
# atlıyor. NEXT_PUBLIC_ ÖN EKİ ALMAYACAK, istemciye sızarsa tüm
# veritabanı yazılabilir hâle gelir.
SUPABASE_SERVICE_ROLE=""
SUPABASE_KOVA="proje-gorsel"
