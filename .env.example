# ─────────────────────────────────────────────────────────────
# Supabase — bölge eu-central-1 (Frankfurt) olmalı
# ─────────────────────────────────────────────────────────────

# Uygulama bağlantısı: Supavisor TRANSACTION mode, port 6543.
# Serverless fonksiyonlar için tek doğru seçenek.
DATABASE_URL="postgres://postgres.PROJE_REF:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Göçler, pg_dump, CREATE INDEX CONCURRENTLY: SESSION mode, port 5432.
DIRECT_URL="postgres://postgres.PROJE_REF:SIFRE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Supabase Auth — panel girişleri için
NEXT_PUBLIC_SUPABASE_URL="https://PROJE_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# DİKKAT: servis rolü anahtarı ASLA NEXT_PUBLIC_ ile başlamaz, yalnızca sunucuda kullanılır
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 — medya
# ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="konutprojeleri"

# Görsellerin servis edildiği alan adı. Vercel'den geçmez.
NEXT_PUBLIC_CDN_URL="https://cdn.konutprojeleri.com"

# ─────────────────────────────────────────────────────────────
# Diğer
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://konutprojeleri.com"

# Vercel Cron uçlarını korumak için. Cron isteği bu değeri Authorization başlığında taşır.
CRON_SECRET=""

# Onay kuyruğu webhook'u — panel "Onayla" dediğinde revalidate tetikler
REVALIDATE_SECRET=""

# ─────────────────────────────────────────────────────────────
# Harita karoları
# ─────────────────────────────────────────────────────────────
# ÜRETİMDE OSM'in genel sunucusu KULLANILMAMALI — kullanım politikası
# yoğun trafiği yasaklıyor. Bu yığında en ucuz yol Protomaps PMTiles
# dosyasını R2'ye koymak: çıkış trafiği zaten ücretsiz, karo başına
# ücret yok. Alternatif: MapTiler, Stadia Maps.
NEXT_PUBLIC_HARITA_KARO="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# Koyu tema için ayrı karo stili. Tanımlanmazsa açık stil kullanılır.
NEXT_PUBLIC_HARITA_KARO_KOYU=""
